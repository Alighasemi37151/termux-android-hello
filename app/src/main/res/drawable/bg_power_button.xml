<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="6dp" android:color="@color/surface_variant" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/brand_primary_light"
                android:endColor="@color/brand_primary_dark"
                android:type="radial"
                android:gradientRadius="80dp" />
        </shape>
    </item>
</layer-list>
